# Vorlage für /opt/docker/apps/cms/.env (mode 600, Besitzer root) — NUR Platzhalter hier.
# Secrets erzeugen: openssl rand -hex 32   (hex: URL-sicher, auch in DATABASE_URL)
#
# Image-Tag = kurzer Git-SHA des gebauten Stands (docker build … -t kozlowski/pk-cms:<kurz-sha>)
CMS_IMAGE_TAG=<kurz-sha>
# Postgres-Passwort (Nutzer/DB heißen cms; DATABASE_URL baut die Compose-Datei daraus)
POSTGRES_PASSWORD=change-me
# Payload-Signaturschlüssel (≥ 32 Zeichen)
PAYLOAD_SECRET=change-me
# Gemeinsames Secret edge02 → payload (Header X-Edge-Secret), ≥ 32 Zeichen; gleicher Wert in edge02-nginx
EDGE_SHARED_SECRET=change-me
# payload → builder (Authorization: Bearer …), ≥ 32 Zeichen
BUILDER_TOKEN=change-me
