DATABASE_URL=postgres://cms:cms-dev@localhost:5433/cms
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Builder (Task 11) — nur serverseitig, nie im Browser. Leer = Vorschau/Veröffentlichen aus.
